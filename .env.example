POSTGRES_USER=miniwsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miniwsa
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/miniwsa
SPRING_DATASOURCE_USERNAME=miniwsa
SPRING_DATASOURCE_PASSWORD=change-me

# Adminer auto-login (http://localhost:8080/adminer-go.html → GET /adminer-go/config).
# User/password/db from SPRING_DATASOURCE_*. Server = hostname Adminer uses inside Docker
# (Compose service/container name). Do NOT use Windows 127.0.0.1 here when Adminer is containerized.
ADMINER_URL=http://localhost:8082/
ADMINER_DEFAULT_SERVER=miniwsa-postgres
# ADMINER_DB=

# Local SonarQube Community only (http://localhost:9000). Create a user token in the UI; never commit a real token.
SONAR_TOKEN=
