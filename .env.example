# Works on Windows and macOS with Docker Desktop / OrbStack / Colima.
POSTGRES_USER=wsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wsa
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wsa
SPRING_DATASOURCE_USERNAME=wsa
SPRING_DATASOURCE_PASSWORD=change-me

# Optional override if host apps cannot reach Kafka (e.g. some Colima setups):
# KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,INTERNAL://kafka:29092

# Adminer auto-login (http://localhost:8080/adminer-go.html → GET /adminer-go/config).
# User/password/db from SPRING_DATASOURCE_*. Server = hostname Adminer uses inside Docker
# (Compose service/container name). Do NOT use host 127.0.0.1 here when Adminer is containerized.
ADMINER_URL=http://localhost:8082/
ADMINER_DEFAULT_SERVER=wsa-postgres
# ADMINER_DB=

# Local SonarQube Community only (http://localhost:9000). Create a user token in the UI; never commit a real token.
SONAR_TOKEN=
