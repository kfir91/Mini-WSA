# Works on Windows and macOS with Docker Desktop / OrbStack / Colima.
# Secrets (DB password, Sonar token) live in HashiCorp Vault — see README → Architecture → Secrets.
# Do not put POSTGRES_PASSWORD / SPRING_DATASOURCE_PASSWORD / SONAR_TOKEN here.
#
# Change ports / host here. Bootstrap derives Spring URL env vars from WSA_HOST + WSA_*_PORT.
# Optional VITE_WSA_* overrides are supported; otherwise Vite maps from WSA_* (see vite.config.ts).

POSTGRES_USER=wsa
POSTGRES_DB=wsa
SPRING_DATASOURCE_USERNAME=wsa

# --- Canonical host / ports (single source of truth) ---
WSA_HOST=localhost
WSA_INGEST_PORT=8081
WSA_ANALYTICS_PORT=8080
WSA_CLIENT_PORT=8084
WSA_ADMINER_PORT=8082
WSA_KAFKA_UI_PORT=8083
WSA_POSTGRES_PORT=5432
WSA_KAFKA_PORT=9092
WSA_VAULT_PORT=8200

# Derived by bootstrap from host+ports above (listed so IDE-only runs work without bootstrap).
# Prefer changing WSA_*_PORT / WSA_HOST; re-run bootstrap to refresh these.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wsa
WSA_ANALYTICS_BASE_URL=http://localhost:8080
ADMINER_URL=http://localhost:8082/
VAULT_URI=http://localhost:8200

# Optional override if host apps cannot reach Kafka (e.g. some Colima setups).
# If unset, bootstrap derives: PLAINTEXT://${WSA_HOST}:${WSA_KAFKA_PORT},INTERNAL://kafka:29092
# KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,INTERNAL://kafka:29092

# Adminer UI. Hub "Connect" opens analytics …/adminer-go.html
# (no password in JSON — PHP autologin uses Compose secrets from Vault at `up` time).
ADMINER_DEFAULT_SERVER=wsa-postgres
# ADMINER_DB=

# HashiCorp Vault (Compose). AppRole ids → gitignored .vault/approle.env (scripts/vault-seed.*).
VAULT_ENABLED=true
# Dev-only root token for seed scripts. Not used by Spring apps.
VAULT_DEV_ROOT_TOKEN_ID=wsa-dev-root
# Optional; seed also writes VAULT_ROLE_ID / VAULT_SECRET_ID into .vault/approle.env
# VAULT_ROLE_ID=
