<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.wsa</groupId>
    <artifactId>wsa</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>WSA</name>
    <description>Local security analytics pipeline</description>

    <modules>
        <module>contracts</module>
        <module>ingest-api</module>
        <module>analytics-service</module>
        <module>generator</module>
        <module>coverage</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mapstruct.version>1.6.2</mapstruct.version>
        <lombok.version>1.18.30</lombok.version>
        <springdoc.version>2.6.0</springdoc.version>
        <openapi-generator.version>7.9.0</openapi-generator.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <jacoco.line.minimum>0.95</jacoco.line.minimum>
        <jacoco.branch.minimum>0.95</jacoco.branch.minimum>

        <!-- Local SonarQube Community only (Docker :9000). No SonarCloud. -->
        <sonar.projectKey>wsa</sonar.projectKey>
        <sonar.projectName>WSA</sonar.projectName>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <!--
          Scope analysis to hand-written trees only. OpenAPI / MapStruct output lives under
          target/generated-sources and is therefore not scanned — no per-package exclusion list.
        -->
        <sonar.sources>src/main/java</sonar.sources>
        <sonar.tests>src/test/java</sonar.tests>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${maven.multiModuleProjectDirectory}/contracts/target/site/jacoco/jacoco.xml,
            ${maven.multiModuleProjectDirectory}/ingest-api/target/site/jacoco/jacoco.xml,
            ${maven.multiModuleProjectDirectory}/analytics-service/target/site/jacoco/jacoco.xml,
            ${maven.multiModuleProjectDirectory}/generator/target/site/jacoco/jacoco.xml,
            ${maven.multiModuleProjectDirectory}/coverage/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <!-- Align Sonar coverage % with JaCoCo for a few hand-written types we also skip there. -->
        <sonar.coverage.exclusions>
            **/*Application.java,
            **/KafkaConsumerConfig.java,
            **/PostgresTimeseriesBucketQuery.java,
            **/GeneratorMain.java,
            **/IngestClient.java,
            **/ConsoleProgress.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- OpenAPI regenerates under target/; incremental compile can skip those classes. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>0.2.0</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <!-- OpenAPI-generated contracts + analytics API models/interfaces -->
                            <exclude>com/wsa/contracts/**</exclude>
                            <exclude>com/wsa/analytics/api/**</exclude>
                            <exclude>com/wsa/ingest/api/Error*</exclude>
                            <exclude>**/*Application*</exclude>
                            <exclude>**/*MapperImpl*</exclude>
                            <!-- Spring Kafka wiring + Postgres-only SQL + generator CLI I/O -->
                            <exclude>**/KafkaConsumerConfig*</exclude>
                            <exclude>**/PostgresTimeseriesBucketQuery*</exclude>
                            <exclude>**/GeneratorMain*</exclude>
                            <exclude>**/IngestClient*</exclude>
                            <exclude>**/ConsoleProgress*</exclude>
                            <!-- JPA entities / enums — covered via repository + service paths -->
                            <exclude>com/wsa/ingest/entity/**</exclude>
                            <exclude>com/wsa/ingest/config/OutboxMetricsConfig*</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Per-module ≥95% ⇒ weighted aggregate ≥95%. -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
